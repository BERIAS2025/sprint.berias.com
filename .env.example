# BERIAS Sprint - Environment Variables Template
# Kopiere diese Datei als .env und trage deine echten Keys ein
# WICHTIG: Die .env Datei niemals in Git einchecken!

# HubSpot API Key (Private App Token)
# Wird für die Lead-Erfassung und das Scoring benötigt
HUBSPOT_API_KEY=YOUR_HUBSPOT_API_KEY_HERE

# Anthropic Claude API Key
# Wird für den Support-Chatbot benötigt
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY_HERE
